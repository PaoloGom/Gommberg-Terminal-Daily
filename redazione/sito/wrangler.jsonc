// gommberg.com su Cloudflare Workers (piano gratuito): i file statici del sito, più un solo pezzo di codice,
// redazione/sito/servizio.js che chiama lettori.js (La Gommunity, G-13, con redazione.js: l'area riservata, G-51, e orologio.js: l'orologio dei controlli, G-58), che Cloudflare
// chiama solo per gli indirizzi /api/* e per il cron qui sotto.
// Lo usa .github/workflows/sito.yml; la cartella _sito la prepara redazione/sito/costruisci.py.
// Se la pubblicazione con il codice non riesce, sito.yml ripubblica i soli file statici (senza "main" e senza database):
// l'edizione esce comunque, la Gommunity dice che la discussione non si carica.
{
  "name": "gommberg",
  "compatibility_date": "2026-11-20",
  "main": "servizio.js",
  "assets": {
    "directory": "../../_sito",
    "binding": "ASSETS",
    // passano dal codice solo /api/* e l'area riservata /redazione (G-51: accesso, pannello, moderazione); ogni altra
    // richiesta va dritta ai file statici, come prima di G-13. Il pannello non è tra i file statici: sta nel codice
    // (_privato/pannello.js, scritto da costruisci.py) e si apre solo dopo l'accesso.
    "run_worker_first": ["/api/*", "/redazione", "/redazione/*"],
    // indirizzi identici a GitHub Pages: /e/030.html resta /e/030.html (le altre modalità lo accorciano)
    "html_handling": "none",
    // le pagine che non esistono aprono 404.html con stato 404
    "not_found_handling": "404-page"
  },
  // commenti, like, segnalazioni e sentiment dei lettori. Il database si crea una volta a mano da Cloudflare
  // (Storage e database, D1, nome gommberg-lettori, creato il 22/11/2026); le tabelle le crea lettori.js al primo uso.
  // Le anteprime usano lo stesso database ma scrivono con sito = "prova": non si mescolano con gommberg.com.
  "d1_databases": [
    { "binding": "DB", "database_name": "gommberg-lettori", "database_id": "486efdce-44ac-41e9-9518-4d772cb4d5c5" }
  ],
  // il sito vero sta solo su gommberg.com: niente doppione su workers.dev
  "workers_dev": false,
  // ma gli indirizzi di anteprima (rami prova e anteprima-*) sì: costruisci.py --anteprima li segna noindex e toglie le statistiche
  "preview_urls": true,
  "routes": [
    { "pattern": "gommberg.com", "custom_domain": true }
  ],
  // L'area riservata (G-51, redazione.js) vuole due segreti che Paolo mette dal pannello di Cloudflare (Workers,
  // gommberg, Impostazioni, Variabili e segreti) e che nessun deploy cancella: REDAZIONE_UTENTE e REDAZIONE_PASSWORD
  // (almeno 16 caratteri). Senza, l'accesso risponde "non ancora configurato". Procedura: redazione/sito/LETTORI.md.
  // l'orologio dei controlli (G-58, orologio.js): un solo cron, in UTC, ogni quarto d'ora; che cosa far partire e
  // quando lo decide il codice sull'ora di Roma. Piano gratuito: 5 cron per account, qui se ne usa uno. Ogni
  // pubblicazione sostituisce i cron con questi (non si cambiano dal pannello di Cloudflare). Il segreto
  // GITHUB_ACTIONS_TOKEN lo mette Paolo dal pannello e nessun deploy lo cancella; GITHUB_REPOSITORY lo passa sito.yml.
  "triggers": { "crons": ["*/15 * * * *"] },
  // i log del codice (errori del servizio dei lettori) si leggono da Cloudflare, Workers, gommberg, Observability
  "observability": { "enabled": true }
}
